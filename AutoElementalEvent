-- DRAG GUI
--============================================================--

local UserInputService = game:GetService("UserInputService")

local dragging = false
local dragStart
local startPos

Title.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1 then

        dragging = true
        dragStart = input.Position
        startPos = Main.Position

    end

end)

Title.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end

end)

UserInputService.InputChanged:Connect(function(input)

    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then

        local delta = input.Position - dragStart

        Main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )

    end

end)

--============================================================--
-- GET REPLION SERVER BROWSER
--============================================================--

local function getServerBrowserReplion()

    if not getgc then
        return nil
    end

    for _, v in pairs(getgc(true)) do

        if typeof(v) == "table" then

            local ok, str = pcall(function()
                return tostring(v)
            end)

            if ok and str == "Replion<ServerBrowser>" then
                return v
            end

        end

    end

    return nil
end

--============================================================--
-- GET CURRENT SERVER DATA
--============================================================--

local function getCurrentServer()

    local replion = getServerBrowserReplion()

    if not replion then
        return nil
    end

    local data = replion.Data

    if not data then
        return nil
    end

    local servers = data.Servers

    if not servers then
        return nil
    end

    for _, server in pairs(servers) do

        if server.JobId == game.JobId then
            return server
        end

    end

    return nil
end

--============================================================--
-- GET ACTIVE EVENTS
--============================================================--

local function getActiveWeather()

    local server = getCurrentServer()

    if not server then

        return {}, nil

    end

    local events = server.Events

    if not events then

        return {}, server

    end

    local found = {}

    for _, event in pairs(events) do

        if typeof(event) == "string" then

            table.insert(found, event)

        end

    end

    return found, server
end

--============================================================--
-- FIND ELEMENTAL WEATHER
--============================================================--

local function findElementalWeather(events)

    for _, event in ipairs(events) do

        local lower = string.lower(event)

        if WeatherLocations[lower] then

            return event, WeatherLocations[lower]

        end

    end

    return nil, nil
end

--============================================================--
-- CHARACTER
--============================================================--

local function getRoot()

    local character = player.Character

    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

--============================================================--
-- SAVE LOCATION
--============================================================--

local SavedLocation = nil

--============================================================--
-- CURRENT WEATHER STATE
--============================================================--

local CurrentWeather = nil
local CurrentTarget = nil
local WeatherActive = false

--============================================================--
-- TELEPORT
--============================================================--

local function teleportTo(cframe)

    local root = getRoot()

    if not root then
        return false
    end

    root.CFrame = cframe

    return true
end

--============================================================--
-- EXACT CFRAME CHECK
--============================================================--
-- Tidak memakai magnitude/toleransi.
-- Position DAN rotation dibandingkan.

local function isExactCFrame(root, target)

    if not root or not target then
        return false
    end

    return root.CFrame == target
end

--============================================================--
-- FORCE WEATHER LOCATION
--============================================================--

local function enforceWeatherLocation()

    if not WeatherActive then
        return
    end

    if not CurrentTarget then
        return
    end

    local targetCFrame = Locations[CurrentTarget]

    if not targetCFrame then
        return
    end

    local root = getRoot()

    if not root then
        return
    end

    -- Tidak ada toleransi.
    -- Sedikit perubahan posisi / arah hadap langsung dikembalikan.

    if not isExactCFrame(root, targetCFrame) then

        root.CFrame = targetCFrame

    end

end

--============================================================--
-- UPDATE GUI
--============================================================--

local function updateGUI(weatherName, targetName)

    if weatherName then

        WeatherLabel.Text = weatherName
        TargetLabel.Text = "Target: " .. tostring(targetName)
        StatusLabel.Text = "Status: WEATHER ACTIVE"

    else

        WeatherLabel.Text = "NONE"
        TargetLabel.Text = "Target: NONE"
        StatusLabel.Text = "Status: Monitoring..."

    end

end

--============================================================--
-- RETURN TO SAVED LOCATION
--============================================================--

local function returnToSavedLocation()

    if not SavedLocation then
        return
    end

    local root = getRoot()

    if not root then
        return
    end

    -- Exact saved CFrame.
    root.CFrame = SavedLocation

    StatusLabel.Text = "Status: RETURNED"

end

--============================================================--
-- WEATHER START
--============================================================--

local function startWeather(weatherName, targetName)

    if WeatherActive then
        return
    end

    local root = getRoot()

    if not root then
        return
    end

    --========================================================--
    -- SIMPAN LOKASI PLAYER SAAT WEATHER BARU TERDETEKSI
    --========================================================--

    SavedLocation = root.CFrame

    CurrentWeather = weatherName
    CurrentTarget = targetName
    WeatherActive = true

    updateGUI(weatherName, targetName)

    StatusLabel.Text = "Status: TELEPORTING..."

    task.wait()

    --========================================================--
    -- TELEPORT KE WEATHER
    --========================================================--

    local targetCFrame = Locations[targetName]

    if targetCFrame then
        root.CFrame = targetCFrame
    end

end

--============================================================--
-- WEATHER END
--============================================================--

local function stopWeather()

    if not WeatherActive then
        return
    end

    WeatherActive = false

    CurrentWeather = nil
    CurrentTarget = nil

    updateGUI(nil, nil)

    StatusLabel.Text = "Status: RETURNING..."

    task.wait()

    --========================================================--
    -- KEMBALI KE LOKASI SEBELUM WEATHER
    --========================================================--

    returnToSavedLocation()

    --========================================================--
    -- HAPUS SAVED LOCATION
    --========================================================--

    SavedLocation = nil

    StatusLabel.Text = "Status: Monitoring..."

end

--============================================================--
-- MAIN WEATHER CHECK
--============================================================--

task.spawn(function()

    while task.wait(CHECK_INTERVAL) do

        local events, server = getActiveWeather()

        local weatherName, targetName =
            findElementalWeather(events)

        --====================================================--
        -- WEATHER AKTIF
        --====================================================--

        if weatherName then

            -- Weather baru
            if not WeatherActive then

                startWeather(
                    weatherName,
                    targetName
                )

            else

                --================================================--
                -- WEATHER MASIH AKTIF
                --================================================--

                CurrentWeather = weatherName
                CurrentTarget = targetName

                WeatherLabel.Text = weatherName
                TargetLabel.Text = "Target: " .. tostring(targetName)
                StatusLabel.Text = "Status: WEATHER ACTIVE"

                --================================================--
                -- PAKSA POSISI + ARAH HADAP
                --================================================--

                enforceWeatherLocation()

            end

        else

            --====================================================--
            -- TIDAK ADA WEATHER
            --====================================================--

            if WeatherActive then

                stopWeather()

            else

                updateGUI(nil, nil)

            end

        end

    end

end)

--============================================================--
-- EXTRA POSITION MONITOR
--============================================================--
-- Ini membuat koreksi posisi lebih cepat daripada menunggu
-- CHECK_INTERVAL.

task.spawn(function()

    while task.wait(0.1) do

        if WeatherActive then

            enforceWeatherLocation()

        end

    end

end)

