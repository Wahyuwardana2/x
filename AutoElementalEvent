--============================================================--
-- TELEPORT
--============================================================--

local lastTeleportEvent = nil

local function teleportToWeather(eventName)

    local target = WeatherTargets[eventName]

    if not target then
        return
    end

    local character = player.Character

    if not character then
        return
    end

    local root = character:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    print("========================================")
    print("ELEMENTAL WEATHER DETECTED")
    print("EVENT:", eventName)
    print("TELEPORT:", target.Name)
    print("========================================")

    root.CFrame =
        target.CFrame +
        Vector3.new(0, HEIGHT_OFFSET, 0)

end

--============================================================--
-- CHECK CURRENT SERVER
--============================================================--

local function checkCurrentServer()

    local replion = getServerBrowserReplion()

    if not replion then

        Status.Text = "REPLION NOT FOUND"
        Status.TextColor3 = Color3.fromRGB(255,80,80)

        return nil

    end

    local data = replion.Data

    if not data then
        return nil
    end

    local servers = data.Servers

    if not servers then

        Status.Text = "SERVERS NIL"
        Status.TextColor3 = Color3.fromRGB(255,80,80)

        return nil

    end

    for _, server in pairs(servers) do

        if server.JobId == game.JobId then

            local events = server.Events

            local eventText = ""

            local detectedEvent = nil

            if events then

                for _, event in pairs(events) do

                    event = tostring(event)

                    eventText =
                        eventText ..
                        "• " ..
                        event ..
                        "\n"

                    if WeatherTargets[event] then
                        detectedEvent = event
                    end

                end

            end

            if eventText == "" then
                eventText = "• NONE"
            end

            EventLog.Text = eventText

            if detectedEvent then

                Status.Text =
                    "ACTIVE : " ..
                    WeatherTargets[detectedEvent].Name

                Status.TextColor3 =
                    Color3.fromRGB(80,255,140)

                if AUTO_TELEPORT then

                    if lastTeleportEvent ~= detectedEvent then

                        lastTeleportEvent = detectedEvent

                        teleportToWeather(detectedEvent)

                    end

                end

            else

                Status.Text = "NO TARGET WEATHER"

                Status.TextColor3 =
                    Color3.fromRGB(255,200,80)

                lastTeleportEvent = nil

            end

            return server
        end

    end

    Status.Text = "CURRENT SERVER NOT FOUND"

    Status.TextColor3 =
        Color3.fromRGB(255,80,80)

    return nil
end

