--============================================================--
-- UPDATE GUI
--============================================================--

local function updateGUI(weather, events)

    if weather then

        Status.Text = "WEATHER: " .. string.upper(weather)

        Status.TextColor3 = Color3.fromRGB(
            100,
            255,
            130
        )

    else

        Status.Text = "WEATHER: NONE"

        Status.TextColor3 = Color3.fromRGB(
            255,
            180,
            100
        )

    end

    local lines = {}

    for i, event in ipairs(events) do

        table.insert(
            lines,
            "[" .. i .. "] " .. tostring(event)
        )

    end

    if #lines == 0 then
        LogBox.Text = "NO EVENTS"
    else
        LogBox.Text = table.concat(lines, "\n")
    end

end

--============================================================--
-- REALTIME WEATHER LOOP
--============================================================--

task.spawn(function()

    print("========================================")
    print("AUTO WEATHER TELEPORT")
    print("REALTIME CHECKER")
    print("NO SERVER HOP")
    print("========================================")

    while task.wait(CHECK_INTERVAL) do

        if not ScreenGui.Parent then
            break
        end

        local weather, events = checkCurrentWeather()

        updateGUI(weather, events)

        --====================================================--
        -- WEATHER ACTIVE
        --====================================================--

        if AutoTeleport and weather then

            if TeleportedWeather ~= weather then

                -- Kalau belum pernah save,
                -- simpan posisi sebelum teleport.
                if not SavedLocation then
                    saveLocation()
                end

                teleportWeather(weather)

                TeleportedWeather = weather
                LastWeather = weather

            end

        --====================================================--
        -- WEATHER NONE
        --====================================================--

        elseif not weather then

            if TeleportedWeather ~= nil then

                print("========================================")
                print("WEATHER ENDED")
                print("RETURNING TO SAVED LOCATION")
                print("========================================")

                returnLocation()

                TeleportedWeather = nil
                LastWeather = nil

            end

        end

    end

end)

