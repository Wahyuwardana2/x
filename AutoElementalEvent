--============================================================--
-- DRAG
--============================================================--

local Dragging = false
local DragStart
local StartPosition

Title.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1 then

        Dragging = true
        DragStart = input.Position
        StartPosition = Main.Position

    end

end)

Title.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        Dragging = false
    end

end)

UserInputService.InputChanged:Connect(function(input)

    if not Dragging then
        return
    end

    if input.UserInputType ~= Enum.UserInputType.MouseMovement then
        return
    end

    local Delta = input.Position - DragStart

    Main.Position = UDim2.new(
        StartPosition.X.Scale,
        StartPosition.X.Offset + Delta.X,
        StartPosition.Y.Scale,
        StartPosition.Y.Offset + Delta.Y
    )

end)

--============================================================--
-- SERVER BROWSER CACHE
--============================================================--

local ServerBrowserReplion = nil
local ReplionSearchFinished = false

local function getServerBrowserReplion()

    if ServerBrowserReplion then
        return ServerBrowserReplion
    end

    if ReplionSearchFinished then
        return nil
    end

    if not getgc then
        ReplionSearchFinished = true
        return nil
    end

    local Success, Objects = pcall(getgc, true)

    if not Success or not Objects then
        return nil
    end

    for _, Object in pairs(Objects) do

        if typeof(Object) == "table" then

            local SuccessName, Name = pcall(tostring, Object)

            if SuccessName and Name == "Replion<ServerBrowser>" then

                ServerBrowserReplion = Object

                return Object
            end

        end

    end

    return nil
end

--============================================================--
-- CURRENT SERVER
--============================================================--

local function getCurrentServer()

    local Replion = getServerBrowserReplion()

    if not Replion then
        return nil
    end

    local Success, Data = pcall(function()
        return Replion.Data
    end)

    if not Success or typeof(Data) ~= "table" then
        return nil
    end

    local Servers = Data.Servers

    if typeof(Servers) ~= "table" then
        return nil
    end

    for _, Server in pairs(Servers) do

        if typeof(Server) == "table"
            and Server.JobId == game.JobId then

            return Server
        end

    end

    return nil
end

--============================================================--
-- ACTIVE WEATHER
--============================================================--

local function getActiveWeather()

    local Server = getCurrentServer()

    if not Server then
        return nil
    end

    local Events = Server.Events

    if typeof(Events) ~= "table" then
        return nil
    end

    for _, Event in pairs(Events) do

        if typeof(Event) == "string" then

            local Target =
                WeatherLocations[string.lower(Event)]

            if Target then
                return Event, Target
            end

        end

    end

    return nil
end

--============================================================--
-- CHARACTER ROOT
--============================================================--

local function getRoot()

    local Character = Player.Character

    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

--============================================================--
-- STATE
--============================================================--

local SavedLocation = nil

local CurrentWeather = nil
local CurrentTarget = nil

local WeatherActive = false

--============================================================--
-- EXACT CFRAME
--============================================================--

local function isExactCFrame(Root, Target)

    return Root
        and Target
        and Root.CFrame == Target
end

--============================================================--
-- ENFORCE POSITION
--============================================================--

local function enforceWeatherLocation()

    if not FORCE_CFRAME then
        return
    end

    if not WeatherActive then
        return
    end

    local Target = Locations[CurrentTarget]

    if not Target then
        return
    end

    local Root = getRoot()

    if not Root then
        return
    end

    if not isExactCFrame(Root, Target) then
        Root.CFrame = Target
    end

end

--============================================================--
-- START WEATHER
--============================================================--

local function startWeather(WeatherName, TargetName)

    local Target = Locations[TargetName]

    if not Target then
        return
    end

    local Root = getRoot()

    if not Root then
        return
    end

    -- Simpan lokasi sebelum teleport
    SavedLocation = Root.CFrame

    CurrentWeather = WeatherName
    CurrentTarget = TargetName
    WeatherActive = true

    updateGUI(
        WeatherName,
        TargetName,
        "TELEPORTING..."
    )

    Root.CFrame = Target

    updateGUI(
        WeatherName,
        TargetName,
        "WEATHER ACTIVE"
    )

end

--============================================================--
-- STOP WEATHER
--============================================================--

local function stopWeather()

    if not WeatherActive then
        return
    end

    local ReturnLocation = SavedLocation

    WeatherActive = false

    CurrentWeather = nil
    CurrentTarget = nil

    updateGUI(
        nil,
        nil,
        "RETURNING..."
    )

    if ReturnLocation then

        local Root = getRoot()

        if Root then
            Root.CFrame = ReturnLocation
        end

    end

    SavedLocation = nil

    updateGUI(
        nil,
        nil,
        "Monitoring..."
    )

end

--============================================================--
-- MAIN WEATHER LOOP
--============================================================--

task.spawn(function()

    while true do

        task.wait(CHECK_INTERVAL)

        local WeatherName, TargetName =
            getActiveWeather()

        --====================================================--
        -- WEATHER ACTIVE
        --====================================================--

        if WeatherName then

            if not WeatherActive then

                -- Weather baru
                startWeather(
                    WeatherName,
                    TargetName
                )

            else

                -- Weather masih aktif
                if CurrentWeather ~= WeatherName
                    or CurrentTarget ~= TargetName then

                    CurrentWeather = WeatherName
                    CurrentTarget = TargetName

                    updateGUI(
                        WeatherName,
                        TargetName,
                        "WEATHER ACTIVE"
                    )

                    -- Jika weather berubah ke target lain
                    local NewTarget = Locations[TargetName]

                    if NewTarget then
                        local Root = getRoot()

                        if Root then
                            Root.CFrame = NewTarget
                        end
                    end

                end

            end

        --====================================================--
        -- WEATHER TIDAK ADA
        --====================================================--

        elseif WeatherActive then

            stopWeather()

        end

    end

end)

--============================================================--
-- LIGHT POSITION LOOP
--============================================================--

task.spawn(function()

    while true do

        task.wait(FORCE_INTERVAL)

        if WeatherActive then
            enforceWeatherLocation()
        end

    end

end)

