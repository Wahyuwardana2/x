--============================================================--
-- REPLION SERVER BROWSER
--============================================================--

local function getServerBrowserReplion()

    if not getgc then
        warn("getgc tidak tersedia.")
        return nil
    end

    for _, v in pairs(getgc(true)) do

        if typeof(v) == "table" then

            local ok, text = pcall(function()
                return tostring(v)
            end)

            if ok and text == "Replion<ServerBrowser>" then
                return v
            end

        end

    end

    return nil
end

--============================================================--
-- EVENT MATCH
--============================================================--

local function matchWeather(eventName)

    if typeof(eventName) ~= "string" then
        return nil
    end

    local lower = string.lower(eventName)

    for weather, names in pairs(WeatherNames) do

        for _, keyword in ipairs(names) do

            if string.find(lower, keyword, 1, true) then
                return weather
            end

        end

    end

    return nil
end

--============================================================--
-- GET CURRENT SERVER
--============================================================--

local function getCurrentServer()

    local replion = getServerBrowserReplion()

    if not replion then
        return nil
    end

    if not replion.Data then
        return nil
    end

    if not replion.Data.Servers then
        return nil
    end

    for _, server in pairs(replion.Data.Servers) do

        if server.JobId == game.JobId then
            return server
        end

    end

    return nil
end

--============================================================--
-- CHECK CURRENT WEATHER
--============================================================--

local function checkCurrentWeather()

    local server = getCurrentServer()

    if not server then
        return nil, {}
    end

    local activeEvents = {}

    if server.Events then

        for _, event in pairs(server.Events) do

            if typeof(event) == "string" then

                table.insert(activeEvents, event)

            end

        end

    end

    -- Cari weather target
    for _, eventName in ipairs(activeEvents) do

        local weather = matchWeather(eventName)

        if weather then
            return weather, activeEvents
        end

    end

    return nil, activeEvents
end

--============================================================--
-- CHARACTER
--============================================================--

local function getRoot()

    local character = player.Character

    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

--============================================================--
-- SAVE LOCATION
--============================================================--

local function saveLocation()

    local root = getRoot()

    if not root then
        return false
    end

    SavedLocation = root.CFrame

    print("========================================")
    print("LOCATION SAVED")
    print("POSITION:", root.Position)
    print("========================================")

    return true
end

--============================================================--
-- RETURN LOCATION
--============================================================--

local function returnLocation()

    if not SavedLocation then
        print("[RETURN] Belum ada lokasi yang disimpan.")
        return false
    end

    local root = getRoot()

    if not root then
        return false
    end

    Returning = true

    root.CFrame = SavedLocation

    task.wait(0.15)

    Returning = false

    print("========================================")
    print("RETURNED TO SAVED LOCATION")
    print("========================================")

    return true
end

--============================================================--
-- TELEPORT WEATHER
--============================================================--

local function teleportWeather(weather)

    local target = Locations[weather]

    if not target then
        return
    end

    local root = getRoot()

    if not root then
        return
    end

    local targetCFrame =
        target + Vector3.new(0, HEIGHT_OFFSET, 0)

    root.CFrame = targetCFrame

    print("========================================")
    print("WEATHER TELEPORT")
    print("WEATHER:", weather)
    print("========================================")
end

