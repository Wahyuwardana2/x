--============================================================--
-- GUI UPDATE CACHE
--============================================================--

local LastWeatherText
local LastTargetText
local LastStatusText

local function setLabel(label, value, cacheName)

    if cacheName == 1 then

        if LastWeatherText == value then
            return
        end

        LastWeatherText = value

    elseif cacheName == 2 then

        if LastTargetText == value then
            return
        end

        LastTargetText = value

    elseif cacheName == 3 then

        if LastStatusText == value then
            return
        end

        LastStatusText = value

    end

    label.Text = value
end

local function updateGUI(weather, target, status)

    setLabel(
        WeatherLabel,
        weather or "NONE",
        1
    )

    setLabel(
        TargetLabel,
        target and ("Target: " .. target) or "Target: NONE",
        2
    )

    setLabel(
        StatusLabel,
        "Status: " .. (status or "Monitoring..."),
        3
    )

end

